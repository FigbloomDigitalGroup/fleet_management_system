// PostgreSQL schema for FIGBLOOM FLEET — a table-for-table translation of
// the Mongoose models in ../models. Conventions:
//
// - Ids are strings. Rows copied from MongoDB keep their ObjectId hex string
//   (so links, signed upload URLs and the phones' cached ids keep working);
//   new rows get a cuid. Controllers still return them as `_id`.
// - Small nested objects that are always read and written whole (alert
//   settings, tracking hours, phone status, geofence/route points, inspection
//   items, proof of delivery, scan details) are JSONB columns, as they were
//   embedded documents in Mongo.
// - Mongo's TTL indexes (resolved alerts after 30 min, expired refresh
//   tokens) have no Postgres equivalent; a cron job deletes those rows.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  PLATFORM_ADMIN
  COMPANY_OWNER
  ADMIN
  DRIVER
  // Company staff roles (FLEET_HR_CONTRACT.md section 0), each with its own
  // menu and API permissions (lib/staffRoles.js). Web only, like ADMIN.
  OPERATOR
  ACCOUNTANT
  MECHANIC
  SUPERVISOR
}

enum AdminAccess {
  full
  dispatcher
  viewer
}

enum CompanyStatus {
  active
  suspended
  pending
  // Not approved in the Figbloom console (the platform's fourth decision);
  // like pending and suspended, nobody in the company can sign in.
  rejected
}

enum Industry {
  logistics_courier
  public_transport
  school_transport
  construction
  taxi_ride_hailing
  security_cash_transit
  agriculture
  government_municipal
  oil_gas
  rental_car
  other
}

enum PaymentMethod {
  mpesa
  paystack
}

enum VehicleType {
  car
  van
  truck
  bus
  motorcycle
  tractor
  excavator
  crane
  dump_truck
  tanker
  armored_vehicle
  trailer
}

enum VehicleStatus {
  active
  idle
  offline
  maintenance
}

enum AlertType {
  speeding
  geofence_entry
  geofence_exit
  unauthorized_movement
  device_offline
  maintenance_due
  route_deviation
  fuel_anomaly
  ai_pattern_anomaly
  sos
  harsh_braking
  harsh_acceleration
  excessive_idling
  admin_message
  harsh_cornering
  phone_use
  mock_location
  location_disabled
  low_battery
  tracking_stopped
  app_logout
  inspection_failed
  job_failed
  phone_left_vehicle
  wrong_vehicle
}

enum DrivingEventType {
  speeding
  harsh_braking
  harsh_acceleration
  harsh_cornering
  phone_use
}

enum DrivingEventSource {
  gps
  sensor
  app
}

enum ExpenseCategory {
  fuel
  toll
  parking
  repair
  other
}

enum GeofenceType {
  circle
  polygon
}

enum JobStatus {
  assigned
  started
  arrived
  completed
  failed
  cancelled
}

enum PingSource {
  device
  driver_app
  manual
}

enum MaintenanceKind {
  record
  reminder
}

enum MaintenanceStatus {
  open
  done
}

enum Plan {
  trial
  basic
  pro
  enterprise
}

enum PaidPlan {
  basic
  pro
}

enum TransactionStatus {
  pending
  success
  failed
  abandoned
}

enum TripPurpose {
  business
  private
}

enum TripEndedBy {
  auto
  driver
}

enum RouteFrequency {
  daily
  weekly
}

enum RouteSource {
  manual
  ai
}

enum UploadKind {
  inspection
  receipt
  pod_photo
  signature
  avatar
  logo
}

enum ScanStatus {
  success
  failed
}

// ── Tenancy and people ──────────────────────────────────────────────────────

model Company {
  id                String         @id @default(cuid())
  name              String
  slug              String         @unique
  status            CompanyStatus  @default(pending)
  subscriptionPlan  String         @default("trial")
  trialEndsAt       DateTime?
  industry          Industry       @default(other)
  paymentMethod     PaymentMethod?
  totalRevenue      Float          @default(0)
  // { lat, lng, geofenceId, updatedAt } — where drivers start their day.
  dailyStartPoint   Json?
  // { speedLimitKph, idleMinutes, offlineMinutes, lowBatteryPercent,
  //   harshBrakingKphPerSec, harshAccelerationKphPerSec, disabledTypes[],
  //   emailRecipientIds[], emailTypes[] } — defaults filled by lib/companySettings.js.
  alertSettings     Json           @default("{\"speedLimitKph\":80,\"idleMinutes\":10,\"offlineMinutes\":15,\"lowBatteryPercent\":15,\"harshBrakingKphPerSec\":12,\"harshAccelerationKphPerSec\":10,\"disabledTypes\":[],\"emailRecipientIds\":[],\"emailTypes\":[]}")
  // { enabled, start, end, days[] }
  trackingHours     Json           @default("{\"enabled\":false,\"start\":\"06:00\",\"end\":\"20:00\",\"days\":[1,2,3,4,5,6]}")
  dataRetentionDays Int            @default(180)
  logoUploadId      String?
  // Dashboard look chosen by the owner: a theme id from the web app's
  // themes list, and the text size (small | normal | large).
  theme             String         @default("forest")
  textSize          String         @default("normal")
  // With theme "custom": the owner's own colours as "#rrggbb" — main
  // (sidebar, buttons) and accent (highlights). Shades are built from them.
  customMainColor   String?
  customAccentColor String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  logo             Upload?             @relation("CompanyLogo", fields: [logoUploadId], references: [id], onDelete: SetNull)
  users            User[]
  vehicles         Vehicle[]
  alerts           Alert[]
  drivingEvents    DrivingEvent[]
  geofenceEvents   GeofenceEvent[]
  expenses         Expense[]
  geofences        Geofence[]
  inspections      Inspection[]
  jobs             Job[]
  jobRoutes        JobRoute[]
  maintenance      MaintenanceRecord[]
  messages         Message[]
  routes           Route[]
  routeCompletions RouteCompletion[]
  transactions     Transaction[]
  uploads          Upload[]            @relation("CompanyUploads")
}

model User {
  id                     String      @id @default(cuid())
  email                  String      @unique // stored lowercase, trimmed
  passwordHash           String
  fullName               String
  role                   Role
  companyId              String?
  adminAccess            AdminAccess @default(full)
  // Driver's tracking consent (Kenya Data Protection Act).
  consentAcceptedAt      DateTime?
  consentVersion         String?
  status                 String      @default("active")
  resetPasswordTokenHash String?
  resetPasswordExpires   DateTime?
  phone                  String?
  dob                    String?
  nationalId             String?
  address                String?
  licenseNumber          String?
  licenseExpiry          String?
  emergencyName          String?
  emergencyPhone         String?
  avatarUploadId         String?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  company          Company?          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  avatar           Upload?           @relation("UserAvatar", fields: [avatarUploadId], references: [id], onDelete: SetNull)
  refreshTokens    RefreshToken[]
  drivenVehicles   Vehicle[]         @relation("VehicleDriver")
  trips            Trip[]
  drivingEvents    DrivingEvent[]
  geofenceEvents   GeofenceEvent[]
  expenses         Expense[]
  inspections      Inspection[]
  jobs             Job[]             @relation("JobDriver")
  jobRoutes        JobRoute[]
  jobsCreated      Job[]             @relation("JobCreator")
  driverMessages   Message[]         @relation("MessageThread")
  sentMessages     Message[]         @relation("MessageSender")
  routeCompletions RouteCompletion[]
  uploads          Upload[]          @relation("UserUploads")

  @@index([companyId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique // sha256 of the token, never the raw value
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt]) // swept by the cleanup cron
}

model PlatformSettings {
  id                    String   @id @default(cuid())
  requireManualApproval Boolean  @default(true)
  defaultPlan           Plan     @default(trial)
  trialDays             Int      @default(14)
  // { trial, basic, pro, enterprise } — max vehicles per plan.
  vehicleLimits         Json     @default("{\"trial\":3,\"basic\":15,\"pro\":50,\"enterprise\":999}")
  supportEmail          String   @default("support@figbloom.org")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

// ── Vehicles and tracking ───────────────────────────────────────────────────

model Vehicle {
  id                      String        @id @default(cuid())
  companyId               String
  plateNumber             String
  make                    String?
  model                   String?
  deviceId                String?       @unique
  trackerToken            String? // secret; never selected unless verifying a ping
  vehicleType             VehicleType   @default(car)
  status                  VehicleStatus @default(offline)
  statusManuallySet       Boolean       @default(false)
  driverId                String?
  startGeofenceId         String?
  fuelCapacityLiters      Float         @default(60)
  avgConsumptionLPer100Km Float         @default(12)
  odometerBaseKm          Float         @default(0)
  // { lastSeenAt, batteryLevel, isCharging, locationEnabled, permission,
  //   appState, isSharing, platform, appVersion, offlineAlertedAt }
  device                  Json?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  company          Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  driver           User?               @relation("VehicleDriver", fields: [driverId], references: [id], onDelete: SetNull)
  startGeofence    Geofence?           @relation(fields: [startGeofenceId], references: [id], onDelete: SetNull)
  pings            LocationPing[]
  trips            Trip[]
  alerts           Alert[]
  drivingEvents    DrivingEvent[]
  geofenceEvents   GeofenceEvent[]
  expenses         Expense[]
  inspections      Inspection[]
  jobs             Job[]
  maintenance      MaintenanceRecord[]
  routes           Route[]
  routeCompletions RouteCompletion[]

  @@unique([companyId, plateNumber])
  @@index([trackerToken])
}

model LocationPing {
  id              String     @id @default(cuid())
  vehicleId       String
  latitude        Float
  longitude       Float
  speedKph        Float?
  heading         Float?
  fuelLevelLiters Float?
  accuracyM       Float?
  isMocked        Boolean    @default(false)
  source          PingSource @default(manual)
  recordedAt      DateTime   @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, recordedAt(sort: Desc)])
}

model Trip {
  id         String       @id @default(cuid())
  vehicleId  String
  driverId   String?
  startTime  DateTime
  endTime    DateTime?
  startLat   Float?
  startLng   Float?
  endLat     Float?
  endLng     Float?
  distanceKm Float?
  purpose    TripPurpose?
  note       String       @default("") @db.VarChar(500)
  endedBy    TripEndedBy?
  // The cleaned, road-snapped path ({ points, geometry }) — computed once
  // after the trip ends (tripController.getTripPath) and cleared whenever
  // the trip's points change.
  roadPath   Json?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driver  User?   @relation(fields: [driverId], references: [id], onDelete: SetNull)

  @@index([vehicleId, startTime])
}

model DrivingEvent {
  id         String             @id @default(cuid())
  companyId  String
  vehicleId  String
  driverId   String?
  type       DrivingEventType
  source     DrivingEventSource
  value      Float?
  speedKph   Float?
  latitude   Float?
  longitude  Float?
  recordedAt DateTime
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driver  User?   @relation(fields: [driverId], references: [id], onDelete: SetNull)

  @@index([driverId, recordedAt(sort: Desc)])
  @@index([companyId, recordedAt(sort: Desc)])
}

model Alert {
  id                String    @id @default(cuid())
  companyId         String
  vehicleId         String
  type              AlertType
  message           String
  resolved          Boolean   @default(false)
  hiddenForDriverAt DateTime?
  resolvedAt        DateTime? // kept as history; deleted after max(90 days, company retention) by lib/cleanup.js
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([companyId, resolved])
  @@index([resolvedAt])
}

model Geofence {
  id        String       @id @default(cuid())
  companyId String
  name      String
  type      GeofenceType
  centerLat Float?
  centerLng Float?
  radiusM   Float?
  polygon   Json         @default("[]") // [{ lat, lng }]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  company       Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  startVehicles Vehicle[]
  events        GeofenceEvent[]

  @@index([companyId])
}

enum GeofenceEventKind {
  enter
  exit
}

// Every time a vehicle crosses a geofence boundary. Kept for reports —
// unlike the geofence alerts, which are deleted 30 minutes after resolving.
// The name is copied in so history survives the geofence being deleted.
model GeofenceEvent {
  id           String            @id @default(cuid())
  companyId    String
  vehicleId    String
  driverId     String?
  geofenceId   String?
  geofenceName String
  kind         GeofenceEventKind
  latitude     Float
  longitude    Float
  recordedAt   DateTime
  createdAt    DateTime          @default(now())

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vehicle  Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driver   User?     @relation(fields: [driverId], references: [id], onDelete: SetNull)
  geofence Geofence? @relation(fields: [geofenceId], references: [id], onDelete: SetNull)

  @@index([companyId, recordedAt(sort: Desc)])
  @@index([vehicleId, recordedAt])
}

// ── Dispatch ────────────────────────────────────────────────────────────────

model Route {
  id              String         @id @default(cuid())
  companyId       String
  vehicleId       String
  name            String
  waypoints       Json           @default("[]") // [{ lat, lng }] in order
  toleranceMeters Float          @default(300)
  speedLimitKph   Float?
  active          Boolean        @default(true)
  frequency       RouteFrequency @default(daily)
  daysOfWeek      Int[]          @default([])
  source          RouteSource    @default(manual)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  company     Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vehicle     Vehicle           @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  completions RouteCompletion[]

  @@index([vehicleId])
}

model RouteCompletion {
  id          String   @id @default(cuid())
  companyId   String
  routeId     String
  vehicleId   String
  driverId    String?
  dateKey     String // "YYYY-MM-DD"
  completedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  route   Route   @relation(fields: [routeId], references: [id], onDelete: Cascade)
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driver  User?   @relation(fields: [driverId], references: [id], onDelete: SetNull)

  @@index([routeId, dateKey])
  @@index([vehicleId, dateKey])
}

model Job {
  id            String    @id @default(cuid())
  companyId     String
  driverId      String?
  vehicleId     String?
  title         String
  address       String
  latitude      Float
  longitude     Float
  contactName   String?
  contactPhone  String?
  notes         String?
  scheduledDate String // "YYYY-MM-DD"
  windowStart   DateTime?
  windowEnd     DateTime?
  sequence      Int       @default(0)
  status        JobStatus @default(assigned)
  failureReason String?
  startedAt     DateTime?
  arrivedAt     DateTime?
  completedAt   DateTime?
  failedAt      DateTime?
  // { photoUploadIds[], signatureUploadId, recipientName, notes,
  //   scannedCode, latitude, longitude, capturedAt }
  proof         Json?
  trackingToken String    @unique
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  driver    User?    @relation("JobDriver", fields: [driverId], references: [id], onDelete: SetNull)
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  createdBy User?    @relation("JobCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([companyId, scheduledDate])
  @@index([driverId, status, sequence])
}

// The road line through one driver's jobs for a day, in the order the
// "Optimize route" button set. Drawn on the dashboard's Jobs map and the
// driver app's Jobs screen; removed when that day's stops change, until the
// next optimize.
model JobRoute {
  id            String   @id @default(cuid())
  companyId     String
  driverId      String
  scheduledDate String // "YYYY-MM-DD"
  path          Json     @default("[]") // [{ lat, lng }] along the roads
  jobIds        String[] @default([]) // the stops, in driving order
  startLat      Float?
  startLng      Float?
  distanceKm    Float?
  durationMin   Float?
  source        String // "google", "osrm" or "straight" (no road data)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  driver  User    @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@unique([driverId, scheduledDate])
  @@index([companyId, scheduledDate])
}

model Message {
  id                String    @id @default(cuid())
  companyId         String
  driverId          String // whose thread this belongs to
  senderId          String
  fromDriver        Boolean
  body              String    @db.VarChar(2000)
  readAt            DateTime?
  hiddenForDriverAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  driver  User    @relation("MessageThread", fields: [driverId], references: [id], onDelete: Cascade)
  sender  User    @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([driverId, createdAt(sort: Desc)])
  @@index([companyId, createdAt(sort: Desc)])
}

// ── Records ─────────────────────────────────────────────────────────────────

model Expense {
  id              String          @id @default(cuid())
  companyId       String
  vehicleId       String
  driverId        String?
  category        ExpenseCategory
  amount          Float // KES
  note            String?
  incurredAt      DateTime        @default(now())
  receiptUploadId String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driver  User?   @relation(fields: [driverId], references: [id], onDelete: SetNull)
  receipt Upload? @relation("ExpenseReceipt", fields: [receiptUploadId], references: [id], onDelete: SetNull)

  @@index([companyId, incurredAt(sort: Desc)])
  @@index([vehicleId, incurredAt(sort: Desc)])
}

model Inspection {
  id         String   @id @default(cuid())
  companyId  String
  vehicleId  String
  driverId   String
  items      Json     @default("[]") // [{ key, label, ok, note, photoUploadId }]
  passed     Boolean
  odometerKm Float?
  notes      String?
  latitude   Float?
  longitude  Float?
  // Signed off by a supervisor, mechanic, full admin or the owner
  // (POST /api/inspections/:id/review); a failed one is "closed" this way.
  reviewedAt   DateTime?
  reviewedById String?
  reviewNote   String?   @db.VarChar(500)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driver  User    @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt(sort: Desc)])
  @@index([vehicleId, createdAt(sort: Desc)])
}

model MaintenanceRecord {
  id            String            @id @default(cuid())
  companyId     String
  vehicleId     String
  kind          MaintenanceKind
  title         String
  notes         String?
  performedAt   DateTime?
  odometerKm    Float?
  costKes       Float?
  dueDate       DateTime?
  dueOdometerKm Float?
  intervalDays  Int?
  intervalKm    Float?
  status        MaintenanceStatus @default(open)
  alertedAt     DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, kind, status])
}

model Transaction {
  id        String            @id @default(cuid())
  companyId String
  plan      PaidPlan
  reference String            @unique
  amount    Float // KES, not subunits
  currency  String            @default("KES")
  status    TransactionStatus @default(pending)
  channel   String?
  paidAt    DateTime?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt(sort: Desc)])
}

// Small images stored in the database (capped at 2 MB in uploadController).
model Upload {
  id           String     @id @default(cuid())
  companyId    String
  uploadedById String
  kind         UploadKind
  contentType  String // "image/jpeg" | "image/png"
  sizeBytes    Int
  data         Bytes // never selected unless serving the raw image
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  company    Company   @relation("CompanyUploads", fields: [companyId], references: [id], onDelete: Cascade)
  uploadedBy User      @relation("UserUploads", fields: [uploadedById], references: [id], onDelete: Cascade)
  logoOf     Company[] @relation("CompanyLogo")
  avatarOf   User[]    @relation("UserAvatar")
  receiptOf  Expense[] @relation("ExpenseReceipt")
}

// ── AI agent ────────────────────────────────────────────────────────────────

model AgentScanLog {
  id              String     @id @default(cuid())
  runAt           DateTime   @default(now())
  vehiclesScanned Int        @default(0)
  anomaliesFound  Int        @default(0)
  status          ScanStatus @default(success)
  errorMessage    String?
  details         Json       @default("[]") // [{ vehicleId, plateNumber, anomaly, reason }]

  @@index([runAt(sort: Desc)])
}

// ── Figbloom platform (FLEET_PLATFORM_CONTRACT.md section 2) ────────────────
// One Company is one platform organisation and one tenant under it, both
// with the company's id as their local id. See lib/platform/.

// The outbox: a company created, renamed or whose owner changed is queued
// here (in the same write where possible) and the every-minute job sends it.
// One row per company: what is sent is read when it is sent, so re-queueing
// a done row re-arms it, and a change while a row is pending bumps its
// version (a send only completes the row if the version is still the one it
// read, so a rename that lands mid-send is sent again).
model PlatformSyncQueue {
  id            Int       @id @default(autoincrement())
  kind          String // "company" | "staff" (a person: fleet.staff.* events)
  localId       String // Company.id, or User.id for "staff"
  // "staff" rows: the person's company when queued, so a removed person's
  // fleet.staff.left still names it.
  companyId     String?
  version       Int       @default(1)
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  lockedUntil   DateTime?
  lastError     String?
  enqueuedAt    DateTime  @default(now())
  doneAt        DateTime?

  @@unique([kind, localId])
  @@index([doneAt, nextAttemptAt])
}

// What the platform knows: kind "organization" or "tenant", the company id,
// the platform's own id for it. lastDecisionAt (organisations) is the
// decided_at of the last decision applied, so an older one arriving late is
// not applied over a newer one.
model PlatformLink {
  kind           String
  localId        String
  platformId     String?
  registeredAt   DateTime  @default(now())
  lastDecisionAt DateTime?

  @@id([kind, localId])
}

// Every decision delivery applied (x-figbloom-delivery), so a repeat is
// acknowledged and not applied twice.
model PlatformDecisionDelivery {
  deliveryId String   @id
  companyId  String
  status     String
  outcome    String
  receivedAt DateTime @default(now())
}

// ── Figbloom staff ──────────────────────────────────────────────────────────

// A Figbloom staff member (PLATFORM_ADMIN) viewing one company's owner area
// read-only (support view). The support token (middleware/auth.js) names this
// row and is only honoured while it is neither ended nor past expiresAt, and
// only for the staff member and company it was issued for. No relations, so
// the record outlives a deleted user or company.
model SupportSession {
  id          String    @id @default(cuid())
  staffUserId String
  companyId   String
  startedAt   DateTime  @default(now())
  expiresAt   DateTime
  endedAt     DateTime?
  // "exit" (staff left), "replaced" (a newer support view by the same person)
  endReason   String?
  ip          String?
  userAgent   String?

  @@index([staffUserId, endedAt])
  @@index([companyId, startedAt])
}

// What Figbloom staff did to customer fleets: support views started and
// ended, fleets created. Append-only; who, which company, when.
model StaffAuditLog {
  id          String   @id @default(cuid())
  staffUserId String
  staffEmail  String
  // support_view_started | support_view_ended | fleet_created
  action      String
  companyId   String
  sessionId   String?
  details     Json?
  createdAt   DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([staffUserId, createdAt])
}

// ── Figbloom HR (FLEET_HR_CONTRACT.md section 3) ────────────────────────────

// Every event delivery from the platform's relay (POST /api/platform/events)
// that was applied (x-figbloom-delivery), so a repeat is acknowledged and not
// applied twice.
model PlatformEventDelivery {
  deliveryId String   @id
  eventId    String?
  type       String
  companyId  String?
  personId   String?
  outcome    String
  receivedAt DateTime @default(now())
}

// A person away on leave approved in Figbloom HR (hr.leave.approved), one
// row per HR application; cancelled (hr.leave.cancelled) keeps the row with
// status "cancelled". Dispatch warns when a job or vehicle is given to a
// driver on these dates. Dates are "YYYY-MM-DD", inclusive.
model DriverUnavailability {
  id            String   @id @default(cuid())
  companyId     String
  userId        String
  source        String   @default("hr")
  applicationId String
  leaveType     String?
  startDate     String
  endDate       String
  halfDay       Boolean  @default(false)
  status        String // "approved" | "cancelled"
  // occurred_at of the last event applied, so an older one arriving late is ignored
  lastEventAt   DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([companyId, source, applicationId])
  @@index([userId, status, startDate])
}
